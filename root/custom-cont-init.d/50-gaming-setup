#!/usr/bin/with-contenv bash
# Runs as root on every container start (SealSkin starts a fresh container per session).

# Flathub for the user installation, which lives in the persistent home: Discover and
# `flatpak install` put apps there, so they are still installed in the next session.
HOME=/config s6-setuidgid abc \
    flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo \
    || echo "**** gaming-setup: could not add the user Flathub remote ****"

# Tell the user once if the Flatpak sandbox can't run (missing permissions in the app entry).
if ! HOME=/config s6-setuidgid abc bwrap --ro-bind / / --proc /proc --dev /dev --unshare-all --share-net /bin/true 2>/dev/null; then
    echo "**** gaming-setup: Flatpak sandbox unavailable; see the README for the required Docker options ****"
fi

# Keyboard layout. Selkies ignores the browser's layout hint in this Wayland session ("the
# session compositor owns the keymap"), and KWin keeps its own layout in ~/.config/kxkbrc. If
# the two differ, keys come out wrong (e.g. Y and Z swapped, or + reaching X11 games such as
# Minecraft as Shift plus a substitute key). So both must use the same layout:
# - KEYBOARD_LAYOUT (e.g. de), if set, is written to KDE's settings;
# - otherwise KDE's own setting (System Settings > Keyboard, saved in the home) is used.
# Selkies then gets the same layout and variant. KDE changes apply from the next session.
KXKBRC=/config/.config/kxkbrc
if [ -n "${KEYBOARD_LAYOUT}" ]; then
    HOME=/config s6-setuidgid abc kwriteconfig6 --file "${KXKBRC}" --group Layout --key LayoutList "${KEYBOARD_LAYOUT}"
    HOME=/config s6-setuidgid abc kwriteconfig6 --file "${KXKBRC}" --group Layout --key Use true
fi
if [ -f "${KXKBRC}" ]; then
    layout=$(kreadconfig6 --file "${KXKBRC}" --group Layout --key LayoutList | cut -d, -f1)
    variant=$(kreadconfig6 --file "${KXKBRC}" --group Layout --key VariantList | cut -d, -f1)
    if [ -n "${layout}" ]; then
        # Read by the s6 services (Selkies) from the container environment
        printf '%s' "${layout}" > /run/s6/container_environment/XKB_DEFAULT_LAYOUT
        printf '%s' "${variant}" > /run/s6/container_environment/XKB_DEFAULT_VARIANT
        echo "**** gaming-setup: keyboard layout ${layout}${variant:+ (${variant})} ****"
    fi
fi

# Stale browser profile locks. Chromium-based browsers (Brave, Chrome, Vivaldi, Edge, ...) and
# Firefox lock their profile with a symlink naming the host and process. Every session is a new
# container with a new hostname, so a lock left by a session that ended with the browser open
# makes the browser refuse to start ("profile in use on another computer"). No browser runs yet
# at this point, so any lock found is stale. Only the lock symlinks are removed.
for dir in /config/.config /config/.var/app /config/.mozilla; do
    [ -d "${dir}" ] || continue
    find "${dir}" -maxdepth 7 -type l \
        \( -name SingletonLock -o -name SingletonCookie -o -name SingletonSocket \
           -o \( -name lock -path '*mozilla*' \) \) \
        -print -delete 2>/dev/null | sed 's/^/**** gaming-setup: removed stale browser lock /'
done
